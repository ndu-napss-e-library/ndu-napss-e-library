# .env.example - Backend Configuration

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ndu_napss_elib
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres
# DB_LOGGING=true  # Set to true for SQL logging

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=30d

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@ndunapsselib.com
EMAIL_FROM_NAME=NDU NAPSS E-Library

# Note: For Gmail, use App Passwords, not regular password
# Enable 2FA and create app password at https://myaccount.google.com/apppasswords

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=524288000  # 500MB in bytes
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,epub

# ============================================
# AWS S3 CONFIGURATION (Optional)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=ndu-napss-elib
AWS_REGION=us-east-1

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ============================================
# SECURITY CONFIGURATION
# ============================================
BCRYPT_ROUNDS=10
SESSION_SECRET=your_session_secret
RATE_LIMIT_WINDOW_MS=15000000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ============================================
# PAGINATION
# ============================================
DEFAULT_PAGE=1
DEFAULT_LIMIT=10
MAX_LIMIT=100

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_2FA=false
ENABLE_SOCIAL_LOGIN=false
ENABLE_OFFLINE_MODE=false

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================
SENDGRID_API_KEY=your_sendgrid_key  # Alternative to nodemailer
TWILIO_ACCOUNT_SID=your_twilio_sid  # For SMS notifications
TWILIO_AUTH_TOKEN=your_twilio_token

# ============================================
# STRIPE CONFIGURATION (If Payment Needed)
# ============================================
STRIPE_SECRET_KEY=your_stripe_key
STRIPE_PUBLIC_KEY=your_stripe_public_key

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_EMAIL=admin@ndunapsselib.com
ADMIN_PASSWORD=change_in_production
