# .env.example - Frontend Configuration

# ============================================
# API CONFIGURATION
# ============================================
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ENV=development
REACT_APP_NAME=NDU NAPSS E-Library

# ============================================
# FEATURE FLAGS
# ============================================
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_OFFLINE_MODE=false

# ============================================
# AUTHENTICATION
# ============================================
REACT_APP_AUTH_TYPE=jwt
REACT_APP_TOKEN_STORAGE=localStorage

# ============================================
# GOOGLE ANALYTICS (Optional)
# ============================================
REACT_APP_GA_ID=

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
REACT_APP_SENTRY_DSN=

# ============================================
# AWS S3 BUCKET (Optional)
# ============================================
REACT_APP_S3_BUCKET=ndu-napss-elib
REACT_APP_S3_REGION=us-east-1

# ============================================
# STRIPE PUBLIC KEY (If Payment Needed)
# ============================================
REACT_APP_STRIPE_PUBLIC_KEY=

# ============================================
# SOCIAL MEDIA LINKS
# ============================================
REACT_APP_FACEBOOK_URL=https://facebook.com/napss
REACT_APP_TWITTER_URL=https://twitter.com/napss
REACT_APP_INSTAGRAM_URL=https://instagram.com/napss
REACT_APP_LINKEDIN_URL=https://linkedin.com/company/napss
